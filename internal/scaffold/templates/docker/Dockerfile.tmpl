{{if ne .Frontend "none"}}FROM node:24-alpine AS frontend
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build
{{end}}
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY . .
# Run go mod tidy && go mod vendor before building this image.
RUN CGO_ENABLED=0 go build -mod=vendor -o /app ./cmd/server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 golar
WORKDIR /app
COPY --from=build /app ./server
{{if ne .Frontend "none"}}COPY --from=frontend /frontend/dist ./frontend/dist{{end}}
RUN mkdir storage && chown golar:golar storage
USER golar
EXPOSE 8080
ENTRYPOINT ["./server"]
