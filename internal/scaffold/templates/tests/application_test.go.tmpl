package tests

import (
 "net/http/httptest"
 "testing"
 "{{.Module}}/internal/bootstrap"
)

func TestHealth(t *testing.T) {
 app,err:=bootstrap.New();if err!=nil{t.Fatal(err)}
 rec:=httptest.NewRecorder()
 app.ServeHTTP(rec,httptest.NewRequest("GET","/health",nil))
 if rec.Code!=200||rec.Body.String()!=`{"status":"ok"}`{t.Fatalf("response = %d %q",rec.Code,rec.Body.String())}
}
func TestAPIGreeting(t *testing.T) {
 app,err:=bootstrap.New();if err!=nil{t.Fatal(err)}
 rec:=httptest.NewRecorder();app.ServeHTTP(rec,httptest.NewRequest("GET","/api/hello",nil))
 if rec.Code!=200{t.Fatalf("status = %d",rec.Code)}
}
