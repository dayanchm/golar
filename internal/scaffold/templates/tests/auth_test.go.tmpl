// newServer migrates a test database and serves the application over HTTP.
func newServer(t *testing.T) *httptest.Server {
 t.Helper()
 server,_:=newMailServer(t)
 return server
}

// newMailServer is newServer with a fake mailer that records the app's email.
func newMailServer(t *testing.T) (*httptest.Server,*mail.Fake) {
 t.Helper()
 if err:=config.LoadEnv("../.env");err!=nil{t.Fatal(err)}
{{if eq .Database "sqlite"}} t.Setenv("DATABASE_DSN",filepath.Join(t.TempDir(),"app.db"))
{{end}}{{if eq .Auth "session"}} t.Setenv("SESSION_SECURE_COOKIE","false")
{{end}} ctx:=context.Background()
 db,err:=database.Open(ctx)
 if err!=nil{
  if os.Getenv("CI")!=""{t.Fatal(err)}
  t.Skipf("database unavailable (set DATABASE_DSN): %v",err)
 }
 t.Cleanup(func(){_=db.Close()})
 if err=migrations.New(db).Migrate(ctx);err!=nil{t.Fatal(err)}
 fake:=mail.NewFake()
 app,err:=bootstrap.NewWithDB(db,mail.WithFrom(fake,"test@example.com"));if err!=nil{t.Fatal(err)}
 server:=httptest.NewServer(app)
 t.Cleanup(server.Close)
 return server,fake
}

type client struct {
 t *testing.T
 http *http.Client
 base string
 headers map[string]string
}

func (c *client) do(method,path string,body any) (int,map[string]any) {
 c.t.Helper()
 var payload bytes.Buffer
 if body!=nil{if err:=json.NewEncoder(&payload).Encode(body);err!=nil{c.t.Fatal(err)}}
 request,err:=http.NewRequest(method,c.base+path,&payload);if err!=nil{c.t.Fatal(err)}
 request.Header.Set("Content-Type","application/json")
 for key,value:=range c.headers{request.Header.Set(key,value)}
 response,err:=c.http.Do(request);if err!=nil{c.t.Fatal(err)}
 defer response.Body.Close()
 result:=map[string]any{}
 _=json.NewDecoder(response.Body).Decode(&result)
 return response.StatusCode,result
}

func uniqueEmail() string {return fmt.Sprintf("user%d@example.com",time.Now().UnixNano())}

var linkPattern=regexp.MustCompile(`https?://\S+`)

// mailedLink returns the link in the latest email to address.
func mailedLink(t *testing.T,fake *mail.Fake,address string) *url.URL {
 t.Helper()
 message:=fake.AssertSent(t,address)
 link,err:=url.Parse(linkPattern.FindString(message.Text))
 if err!=nil||link.Query().Get("token")==""{t.Fatalf("no link in %q",message.Text)}
 return link
}

func TestPasswordResetAndEmailVerification(t *testing.T) {
 server,fake:=newMailServer(t)
 c:=&client{t: t,http: server.Client(),base: server.URL,headers: map[string]string{}}
{{if eq .Auth "session"}} jar,err:=cookiejar.New(nil);if err!=nil{t.Fatal(err)}
 c.http=&http.Client{Jar: jar}
 csrf:=func(){_,body:=c.do("GET","/api/auth/csrf",nil);c.headers["X-CSRF-Token"],_=body["token"].(string)}
 csrf()
{{end}} email:=uniqueEmail()
 code,body:=c.do("POST","/api/auth/register",map[string]string{"name":"Ada","email":email,"password":"correct horse"})
 if code!=http.StatusCreated{t.Fatalf("register = %d %v",code,body)}
{{if eq .Auth "token"}} c.headers["Authorization"]="Bearer "+body["token"].(string)
{{else}} csrf() // logging in rotates the token
{{end}}
 // Registering sends a verification link; asking again sends a fresh one.
 fake.AssertCount(t,1)
 if code,_=c.do("POST","/api/auth/email/verification-notification",nil);code!=http.StatusAccepted{t.Fatalf("resend = %d",code)}
 fake.AssertCount(t,2)
 verify:=mailedLink(t,fake,email)
 if code,_=c.do("GET","/api/auth/verify-email?token=forged",nil);code!=http.StatusUnprocessableEntity{t.Fatalf("forged verification = %d",code)}
 if code,body=c.do("GET",verify.RequestURI(),nil);code!=http.StatusOK{t.Fatalf("verify = %d %v",code,body)}
 if _,body=c.do("GET","/api/auth/me",nil);body["email_verified"]!=true{t.Fatalf("me after verify = %v",body)}

 // Unknown emails get the same answer and no email.
 fake.Reset()
 if code,_=c.do("POST","/api/auth/forgot-password",map[string]string{"email":"nobody@example.com"});code!=http.StatusAccepted{t.Fatalf("forgot unknown = %d",code)}
 fake.AssertNothingSent(t)
 if code,_=c.do("POST","/api/auth/forgot-password",map[string]string{"email":email});code!=http.StatusAccepted{t.Fatalf("forgot = %d",code)}
 reset:=mailedLink(t,fake,email)
 if reset.Path!="/reset-password"||reset.Query().Get("email")!=email{t.Fatalf("reset link = %s",reset)}
 if code,_=c.do("POST","/api/auth/forgot-password",map[string]string{"email":email});code!=http.StatusTooManyRequests{t.Fatalf("second forgot = %d",code)}
 change:=map[string]string{"email":email,"token":"wrong","password":"a brand new password"}
 if code,_=c.do("POST","/api/auth/reset-password",change);code!=http.StatusUnprocessableEntity{t.Fatalf("wrong token = %d",code)}
 change["token"]=reset.Query().Get("token")
 if code,body=c.do("POST","/api/auth/reset-password",change);code!=http.StatusOK{t.Fatalf("reset = %d %v",code,body)}
 if code,_=c.do("POST","/api/auth/reset-password",change);code!=http.StatusUnprocessableEntity{t.Fatalf("reused token = %d",code)}
{{if eq .Auth "token"}} if code,_=c.do("GET","/api/auth/me",nil);code!=http.StatusUnauthorized{t.Fatalf("token after reset = %d",code)}
 delete(c.headers,"Authorization")
{{end}} if code,_=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"correct horse"});code!=http.StatusUnauthorized{t.Fatalf("old password = %d",code)}
 if code,_=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"a brand new password"});code!=http.StatusOK{t.Fatalf("new password = %d",code)}
}
