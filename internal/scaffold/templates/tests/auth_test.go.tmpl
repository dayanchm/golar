func TestSessionAuthentication(t *testing.T) {
 server:=newServer(t)
 jar,err:=cookiejar.New(nil);if err!=nil{t.Fatal(err)}
 c:=&client{t: t,http: &http.Client{Jar: jar},base: server.URL,headers: map[string]string{}}
 csrf:=func(){
  code,body:=c.do("GET","/api/auth/csrf",nil)
  token,_:=body["token"].(string)
  if code!=http.StatusOK||token==""{t.Fatalf("csrf = %d %v",code,body)}
  c.headers["X-CSRF-Token"]=token
 }
 email:=uniqueEmail()
 credentials:=map[string]string{"name":"Ada","email":email,"password":"correct horse"}
 if code,_:=c.do("POST","/api/auth/register",credentials);code!=http.StatusForbidden{t.Fatalf("register without CSRF = %d",code)}
 csrf()
 if code,body:=c.do("POST","/api/auth/register",credentials);code!=http.StatusCreated{t.Fatalf("register = %d %v",code,body)}
 if code,body:=c.do("GET","/api/auth/me",nil);code!=http.StatusOK||body["email"]!=email{t.Fatalf("me = %d %v",code,body)}
 csrf() // logging in rotates the token
 if code,_:=c.do("POST","/api/auth/logout",nil);code!=http.StatusNoContent{t.Fatalf("logout = %d",code)}
 if code,_:=c.do("GET","/api/auth/me",nil);code!=http.StatusUnauthorized{t.Fatalf("me after logout = %d",code)}
 csrf()
 if code,_:=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"wrong password"});code!=http.StatusUnauthorized{t.Fatalf("wrong password = %d",code)}
 if code,body:=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"correct horse"});code!=http.StatusOK{t.Fatalf("login = %d %v",code,body)}
 if code,_:=c.do("GET","/api/auth/me",nil);code!=http.StatusOK{t.Fatalf("me after login = %d",code)}
}
