func TestTokenAuthentication(t *testing.T) {
 server:=newServer(t)
 c:=&client{t: t,http: server.Client(),base: server.URL,headers: map[string]string{}}
 email:=uniqueEmail()
 code,body:=c.do("POST","/api/auth/register",map[string]string{"name":"Ada","email":email,"password":"correct horse"})
 if code!=http.StatusCreated||body["token"]==""{t.Fatalf("register = %d %v",code,body)}
 if code,_=c.do("GET","/api/auth/me",nil);code!=http.StatusUnauthorized{t.Fatalf("anonymous me = %d",code)}
 if code,body=c.do("POST","/api/auth/register",map[string]string{"name":"Ada","email":email,"password":"correct horse"});code!=http.StatusUnprocessableEntity{t.Fatalf("duplicate register = %d %v",code,body)}
 if code,_=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"wrong password"});code!=http.StatusUnauthorized{t.Fatalf("wrong password = %d",code)}
 code,body=c.do("POST","/api/auth/login",map[string]string{"email":email,"password":"correct horse"})
 token,_:=body["token"].(string)
 if code!=http.StatusOK||token==""{t.Fatalf("login = %d %v",code,body)}
 c.headers["Authorization"]="Bearer "+token
 if code,body=c.do("GET","/api/auth/me",nil);code!=http.StatusOK||body["email"]!=email{t.Fatalf("me = %d %v",code,body)}
 if code,_=c.do("POST","/api/auth/logout",nil);code!=http.StatusNoContent{t.Fatalf("logout = %d",code)}
 if code,_=c.do("GET","/api/auth/me",nil);code!=http.StatusUnauthorized{t.Fatalf("revoked token = %d",code)}
}
