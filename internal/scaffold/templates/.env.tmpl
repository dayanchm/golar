APP_NAME={{.Name}}
APP_ADDR=:8080
{{if ne .Database "none"}}DB_DRIVER={{.Database}}
DATABASE_DSN={{.DSN}}{{end}}
{{if ne .Auth "none"}}# Public base URL used in email links.
APP_URL=http://localhost:8080
# Signs email verification links. Keep it secret; changing it voids open links.
APP_KEY={{.AppKey}}
# log prints mail to the server log; set smtp and MAIL_HOST to deliver it.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME={{.Name}}
{{end}}{{if eq .Auth "session"}}# database keeps sessions across restarts and instances; memory is for tests.
SESSION_DRIVER=database
# Local HTTP development only; remove in production so cookies require HTTPS.
SESSION_SECURE_COOKIE=false{{end}}
