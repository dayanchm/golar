APP_NAME={{.Name}}
APP_ADDR=:8080
{{if ne .Database "none"}}DB_DRIVER={{.Database}}
DATABASE_DSN={{.DSN}}{{end}}
{{if eq .Auth "session"}}# database keeps sessions across restarts and instances; memory is for tests.
SESSION_DRIVER=database
# Local HTTP development only; remove in production so cookies require HTTPS.
SESSION_SECURE_COOKIE=false{{end}}
