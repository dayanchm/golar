APP_NAME={{.Name}}
APP_ADDR=:8080
{{if ne .Database "none"}}DB_DRIVER={{.Database}}
DATABASE_DSN={{.DSN}}{{end}}
{{if ne .Auth "none"}}APP_URL=http://localhost:8080
# At least 32 random characters, for example: openssl rand -base64 32
APP_KEY=
# log or smtp.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# starttls, tls or none (none only for local catchers such as Mailpit).
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME={{.Name}}
{{end}}{{if eq .Auth "session"}}# database or memory.
SESSION_DRIVER=database
# Set to false only for local HTTP development.
SESSION_SECURE_COOKIE={{end}}
