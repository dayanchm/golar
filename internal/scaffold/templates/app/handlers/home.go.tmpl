package handlers

import (
 "net/http"
 "github.com/dayanchm/golar"
{{if ne .Template "api"}} "{{.Module}}/web"{{end}}
)

func Home(c *golar.Context) error {
{{if eq .Template "api"}} return c.JSON(http.StatusOK,map[string]string{"name":"{{.Name}}","status":"ok"})
{{else}} return c.Render(http.StatusOK,web.Templates,"index.html",nil)
{{end}}}
func Health(c *golar.Context) error {return c.JSON(http.StatusOK,map[string]string{"status":"ok"})}
func Greeting(c *golar.Context) error {return c.JSON(http.StatusOK,map[string]string{"message":"Hello from {{.Name}}"})}
