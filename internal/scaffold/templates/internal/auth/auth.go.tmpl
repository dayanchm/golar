// Package auth wires Golar's auth package to the application's users.
package auth

import (
 "context"
 "fmt"
 "net/http"
 "os"
 "strings"
 "time"

 "github.com/dayanchm/golar"
 "github.com/dayanchm/golar/auth"
{{if eq .Auth "session"}} "github.com/dayanchm/golar/http/session"
{{end}} "github.com/dayanchm/golar/mail"
 "{{.Module}}/app/models"
 "{{.Module}}/internal/database"
)

// Auth holds the guards and services shared by handlers and middleware.
// Routes are registered before the database opens, so Init fills in the
// database-backed parts during startup.
type Auth struct {
 Users *auth.ORMProvider[models.User]
 Login *auth.Authenticator
 // Throttle limits register, login and password reset requests per client IP.
 Throttle *auth.Limiter
{{if eq .Auth "token"}} Tokens *auth.TokenGuard
{{else}} Sessions *session.Manager
 Guard *auth.SessionGuard
{{end}} // Mailer sends password reset and verification emails, configured by MAIL_* in .env.
 Mailer mail.Mailer
 Resets *auth.PasswordBroker
 Verification *auth.EmailVerification
}

// New configures authentication from the environment. A nil mailer uses
// MAIL_DRIVER and the other MAIL_* variables.
func New(mailer mail.Mailer) (*Auth,error) {
 if mailer==nil{
  var err error
  if mailer,err=mail.FromEnv();err!=nil{return nil,err}
 }
 key:=os.Getenv("APP_KEY")
 if len(key)<32{return nil,fmt.Errorf("APP_KEY must be at least 32 characters; generate one with: openssl rand -base64 32")}
 appURL:=strings.TrimRight(os.Getenv("APP_URL"),"/")
 if appURL==""{appURL="http://localhost:8080"}
 appName:=os.Getenv("APP_NAME")
 users:=&auth.ORMProvider[models.User]{}
 a:=&Auth{
  Users: users,
  Login: &auth.Authenticator{Provider: users,Limiter: auth.NewLimiter(5,time.Minute)},
  Throttle: auth.NewLimiter(20,time.Minute),
{{if eq .Auth "token"}}  Tokens: &auth.TokenGuard{Provider: users},
{{else}}  Sessions: session.NewManager(),
  Guard: &auth.SessionGuard{Provider: users},
{{end}}  Mailer: mailer,
  Resets: &auth.PasswordBroker{
   Provider: users,
   // The link opens APP_URL/reset-password?token=…&email=…; serve that page
   // from your frontend and POST its form to /api/auth/reset-password.
   Send: auth.PasswordResetMail{Mailer: mailer,URL: appURL+"/reset-password",AppName: appName}.Send,
  },
  Verification: &auth.EmailVerification{
   Secret: []byte(key),
   Provider: users,
   Send: auth.VerificationMail{Mailer: mailer,URL: appURL+"/api/auth/verify-email",AppName: appName}.Send,
  },
 }
{{if eq .Auth "session"}} // Browsers only send Secure cookies over HTTPS, except on localhost.
 a.Sessions.Insecure=os.Getenv("SESSION_SECURE_COOKIE")=="false"
{{end}} return a,nil
}

// Init connects the user provider, reset tokens{{if eq .Auth "token"}} and API tokens{{else}} and, unless SESSION_DRIVER=memory, sessions{{end}} to db.
func (a *Auth) Init(db *database.DB) {
 a.Users.DB=db
 a.Resets.Store=&auth.SQLResetStore{DB: db}
{{if eq .Auth "token"}} tokens:=&auth.SQLTokenStore{DB: db}
 a.Tokens.Store=tokens
 // A password reset signs out every API client of that user.
 a.Resets.OnReset=func(ctx context.Context,user auth.Authenticatable) error {return tokens.DeleteUser(ctx,user.AuthID())}
{{else}} if os.Getenv("SESSION_DRIVER")!="memory"{a.Sessions.Store=&session.SQLStore{DB: db}}
{{end}}}
{{if eq .Auth "session"}}
// PruneSessions deletes expired database sessions every hour until ctx ends.
func (a *Auth) PruneSessions(ctx context.Context) {
 if store,ok:=a.Sessions.Store.(*session.SQLStore);ok{store.PruneEvery(ctx,time.Hour)}
}
{{end}}
// Guards returns the guards that authenticate requests, in order.
func (a *Auth) Guards() []auth.Guard {
{{if eq .Auth "token"}} return []auth.Guard{a.Tokens}
{{else}} return []auth.Guard{a.Guard}
{{end}}}
{{if eq .Auth "session"}}
// Middleware loads the session and checks the CSRF token on unsafe requests.
func (a *Auth) Middleware() []golar.Middleware {
 return []golar.Middleware{a.Sessions.Middleware,auth.CSRF}
}
{{end}}
// Required rejects unauthenticated requests with 401 before handler runs.
func (a *Auth) Required(handler golar.Handler) golar.Handler {
 return With(handler,auth.Required(a.Guards()...))
}

// Throttled rejects clients that exceed Throttle with 429.
func (a *Auth) Throttled(handler golar.Handler) golar.Handler {
 return With(handler,auth.RateLimit(a.Throttle,nil))
}

// With runs standard middleware around a single Golar handler. Errors from
// handler still reach the application's error handler.
func With(handler golar.Handler,middleware ...func(http.Handler) http.Handler) golar.Handler {
 return func(c *golar.Context) error {
  var err error
  var next http.Handler=http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){
   c.Writer,c.Request=w,r
   err=handler(c)
  })
  for i:=len(middleware)-1;i>=0;i--{next=middleware[i](next)}
  next.ServeHTTP(c.Writer,c.Request)
  return err
 }
}
