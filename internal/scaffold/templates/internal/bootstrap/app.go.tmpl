{{if ne .Database "none"}}// New builds the application; the database opens when it starts.
func New() (*golar.Application,error) {return build(nil{{if ne .Auth "none"}},nil{{end}})}

// NewWithDB builds the application on an already open database, for tests.
// The caller closes db.{{if ne .Auth "none"}} Pass a mailer, such as mail.NewFake(), to capture
// email instead of using MAIL_DRIVER.{{end}}
func NewWithDB(db *database.DB{{if ne .Auth "none"}},mailer ...mail.Mailer{{end}}) (*golar.Application,error) {
{{if ne .Auth "none"}} var m mail.Mailer
 if len(mailer)>0{m=mailer[0]}
 return build(db,m)
{{else}} return build(db)
{{end}}}

func build(db *database.DB{{if ne .Auth "none"}},mailer mail.Mailer{{end}}) (*golar.Application,error) {
{{else}}func New() (*golar.Application,error) {
{{end}} if err:=config.LoadEnv(".env");err!=nil{return nil,err}
 app:=golar.New()
 app.Use(
  middleware.RequestID(),
  middleware.Logger(),
  middleware.Recovery(),
  middleware.SecureHeaders(),
  middleware.BodyLimit(10<<20), // 10 MiB
  middleware.Compress(),
 )
{{if ne .Frontend "none"}} app.Use(frontend()){{end}}
{{if ne .Auth "none"}} a,err:=auth.New(mailer)
 if err!=nil{return nil,err}
{{if eq .Auth "session"}} app.Use(a.Middleware()...)
{{end}} routes.Register(app,a)
{{else}} routes.Register(app)
{{end}}{{if ne .Database "none"}} if db!=nil{
{{if ne .Auth "none"}}  a.Init(db)
{{end}}  return app,nil
 }
 app.OnStart(func(ctx context.Context) error {
  var err error
  db,err=database.Open(ctx)
{{if ne .Auth "none"}}  if err==nil{a.Init(db)}
{{end}}{{if eq .Auth "session"}}  if err==nil{go a.PruneSessions(ctx)}
{{end}}  return err
 })
 app.OnShutdown(func(context.Context) error {if db!=nil{return db.Close()};return nil})
{{end}} return app,nil
}
{{if ne .Frontend "none"}}
// Production serves Vite's build; development uses Vite's /api proxy.
func frontend() golar.Middleware {
 return func(next http.Handler) http.Handler {
  return http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){
   if r.Method!="GET"&&r.Method!="HEAD"||r.URL.Path=="/api"||strings.HasPrefix(r.URL.Path,"/api/")||r.URL.Path=="/health" {next.ServeHTTP(w,r);return}
   root:=os.DirFS("frontend/dist")
   if _,err:=fs.Stat(root,"index.html");err!=nil{next.ServeHTTP(w,r);return}
   path:=strings.TrimPrefix(r.URL.Path,"/")
   if path==""{http.ServeFile(w,r,"frontend/dist/index.html");return}
   if !fs.ValidPath(path){http.NotFound(w,r);return}
   if info,err:=fs.Stat(root,path);err==nil&&!info.IsDir(){http.FileServer(http.FS(root)).ServeHTTP(w,r);return}
   if filepath.Ext(path)!=""{http.NotFound(w,r);return}
   http.ServeFile(w,r,"frontend/dist/index.html")
  })
 }
}
{{end}}
