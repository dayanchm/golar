package config

import (
 "bufio"
 "fmt"
 "os"
 "regexp"
 "strconv"
 "strings"
)

// LoadEnv accepts KEY=value lines and quoted values; existing process variables win.
func LoadEnv(path string) error {
 file,err:=os.Open(path);if os.IsNotExist(err){return nil};if err!=nil{return err};defer file.Close()
 keyPattern:=regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
 scanner:=bufio.NewScanner(file)
 for line:=1;scanner.Scan();line++ {
  value:=strings.TrimSpace(scanner.Text());if value==""||strings.HasPrefix(value,"#"){continue}
  key,value,ok:=strings.Cut(strings.TrimPrefix(value,"export "),"=");key=strings.TrimSpace(key);value=strings.TrimSpace(value)
  if !ok||!keyPattern.MatchString(key){return fmt.Errorf("%s line %d: expected KEY=value",path,line)}
  if strings.HasPrefix(value,"\""){decoded,e:=strconv.Unquote(value);if e!=nil{return fmt.Errorf("%s line %d: %w",path,line,e)};value=decoded} else if strings.HasPrefix(value,"'"){if !strings.HasSuffix(value,"'")||len(value)<2{return fmt.Errorf("%s line %d: invalid quoted value",path,line)};value=value[1:len(value)-1]}
  if _,exists:=os.LookupEnv(key);!exists{if err=os.Setenv(key,value);err!=nil{return err}}
 }
 return scanner.Err()
}
